@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BloodDonorApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BloodDonorApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <header>
        


<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
    <div class="container-fluid">

        <!-- Mobile hamburger - LEFT -->
        <button class="navbar-toggler d-lg-none me-3"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#mobileMenu"
                aria-controls="mobileMenu"
                aria-label="Open navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Brand / Logo -->
        <a class="navbar-brand me-auto me-lg-5"
           asp-controller="Home"
           asp-action="Index">
            🩸
            <span class="d-none d-md-inline">
                BloodDonorApp
            </span>
            <span class="d-md-none">
                Blood Donor
            </span>
        </a>

        <!-- Desktop navigation -->
        <div class="d-none d-lg-flex align-items-center ms-lg-4">
            <ul class="navbar-nav gap-lg-3">

                <li class="nav-item">
                    <a class="nav-link text-dark @(currentController == "Home" && currentAction == "Index" ? "border-bottom border-danger border-3" : "")"
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-dark @(currentController == "Home" && currentAction == "LearnMore" ? "border-bottom border-danger border-3" : "")"
                       asp-controller="Home"
                       asp-action="LearnMore">
                        🩸Blood Guide &Donation
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-dark @(currentController == "Home" && currentAction == "Privacy" ? "border-bottom border-danger border-3" : "")"
                       asp-controller="Home"
                       asp-action="Privacy">
                        Privacy & Policy
                    </a>
                </li>

            </ul>
        </div>

        <!-- Login/Register or Profile - ALWAYS RIGHT -->
        <div class="ms-auto d-flex align-items-center gap-2">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="btn btn-outline-danger btn-sm dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        @User.Identity.Name
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Account"
                               asp-action="Profile">
                                View Your Info
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <li>
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">
                                <button type="submit"
                                        class="dropdown-item text-danger">
                                    Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-outline-danger btn-sm"
                   asp-controller="Account"
                   asp-action="Login">
                    Login
                </a>

                <a class="btn btn-danger btn-sm"
                   asp-controller="Account"
                   asp-action="Register">
                    Register
                </a>
            }

        </div>

    </div>
</nav>

<!-- MOBILE OFFCANVAS MENU -->
<div class="offcanvas offcanvas-start"
     
     tabindex="-1"
     id="mobileMenu"
     aria-labelledby="mobileMenuLabel"
     data-bs-backdrop="true"
     data-bs-scroll="false">

    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold text-danger"
            id="mobileMenuLabel">
            🩸 Navigation
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Close">
        </button>
    </div>

    <div class="offcanvas-body">

        <ul class="navbar-nav gap-3">

            <li class="nav-item">
                <a class="nav-link text-dark px-3 @(currentController == "Home" && currentAction == "Index" ? "border-bottom border-danger border-3" : "")"
                   asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-dark px-3 @(currentController == "Home" && currentAction == "LearnMore" ? "border-bottom border-danger border-3" : "")"
                   asp-controller="Home"
                   asp-action="LearnMore">
                    🩸Blood Guide &Donation
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-dark px-3 @(currentController == "Home" && currentAction == "Privacy" ? "border-bottom border-danger border-3" : "")"
                   asp-controller="Home"
                   asp-action="Privacy">
                    Privacy & Policy
                </a>
            </li>

        </ul>

    </div>
</div>


    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BloodDonorApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

    <script>
    window.addEventListener('resize', function () {
        if (window.innerWidth >= 992) {
            const menu = document.getElementById('mobileMenu');
            const instance = bootstrap.Offcanvas.getInstance(menu);

            if (instance) {
                instance.hide();
            }
        }
    });
</script>