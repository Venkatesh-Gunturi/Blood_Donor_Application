
@model BloodDonorApp.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">
                            🩸 Forgot Password
                        </h2>
                        <p class="text-muted small">
                            Enter your registered email address
                            and mobile number to request a password reset.
                        </p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="ForgotPassword"
                          method="post">

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter registered email" />

                            <span asp-validation-for="Email"
                                  class="text-danger d-block"
                                  style="font-size:12px;"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MobileNumber"
                                   class="form-label fw-semibold">
                                Mobile Number
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="MobileNumber"
                                   type="tel"
                                   class="form-control"
                                   maxlength="10"
                                   inputmode="numeric"
                                   placeholder="Enter registered mobile number" />

                            <span asp-validation-for="MobileNumber"
                                  class="text-danger d-block"
                                  style="font-size:12px;"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-danger btn-lg w-100 rounded-3 fw-semibold">
                            Request Password Reset
                        </button>

                        <p class="text-center mt-4 mb-0">
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="text-danger text-decoration-none fw-semibold">
                                Back to Login
                            </a>
                        </p>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
