
@model BloodDonorApp.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Donor Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">
                            🩸 Donor Login
                        </h2>
                        <p class="text-muted small">
                            Welcome back! Sign in to your account.
                        </p>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small">
        @TempData["SuccessMessage"]
    </div>
}

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">


                       

<div class="mb-3">
    <label asp-for="LoginIdentifier"
           class="form-label fw-semibold">
        Email or Mobile Number
        <span class="text-danger">*</span>
    </label>

    <input asp-for="LoginIdentifier"
           class="form-control"
           placeholder="Enter email or mobile number" />

    <span asp-validation-for="LoginIdentifier"
          class="text-danger d-block"
          style="font-size:12px;"></span>
</div>



                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Password
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter your password" />

                            <span asp-validation-for="Password"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <div class="form-check">
                                <input asp-for="RememberMe"
                                       class="form-check-input" />

                                <label asp-for="RememberMe"
                                       class="form-check-label small">
                                    Remember Me
                                </label>
                            </div>

                            <a asp-controller="Account"
                               asp-action="ForgotPassword"
                               class="text-danger small text-decoration-none">
                                Forgot Password?
                            </a>
                        </div>

                        <button type="submit"
                                class="btn btn-success btn-lg w-100 rounded-3 fw-semibold">
                            Login
                        </button>

                        <p class="text-center text-muted small mt-4 mb-0">
                            Don't have an account?
                            <a asp-controller="Account"
                               asp-action="Register"
                               class="text-danger fw-semibold text-decoration-none">
                                Register Here
                            </a>
                        </p>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
