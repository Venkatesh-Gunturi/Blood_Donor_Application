
@model BloodDonorApp.ViewModels.DonorDetailsViewModel

@{
    // Status 2 = Recently donated (Red)
    // Status 1 = Potentially eligible (Green)
    // Status 0 = Donation date not provided (Green, unverified)

    bool isRecentlyDonated = Model.DonationStatus == 2;

    string themeColor = isRecentlyDonated
        ? "danger"
        : "success";
}


<div class="modal-header bg-@themeColor text-white">

    <div class="d-flex align-items-center flex-wrap gap-3">

        <h3 class="modal-title fw-bold mb-0"
            id="donorDetailsModalLabel">
            @Model.FullName
        </h3>

        <span class="badge bg-white text-@themeColor fs-6">
            @Model.BloodGroup
        </span>

    </div>

    <button type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="modal"
            aria-label="Close">
    </button>

</div>


<div class="modal-body">

    <h5 class="fw-bold mb-3">
        <i class="bi bi-person-vcard me-2"></i>
        Donor Information
    </h5>

    <!-- THREE COLUMNS ON DESKTOP -->
    <div class="row g-3 mb-4">

        <div class="col-4">
            <small class="text-muted">Age</small>
            <div class="fw-semibold">
                @Model.Age years
            </div>
        </div>

        <div class="col-4">
            <small class="text-muted">Gender</small>
            <div class="fw-semibold">
                @Model.Gender
            </div>
        </div>

        <div class="col-4">
            <small class="text-muted">State</small>
            <div class="fw-semibold">
                @Model.State
            </div>
        </div>

        <div class="col-4">
            <small class="text-muted">PIN Code</small>
            <div class="fw-semibold">
                @Model.PinCode
            </div>
        </div>

        <div class="col-4">
            <small class="text-muted">City</small>
            <div class="fw-semibold">
                @(string.IsNullOrWhiteSpace(Model.City)
                    ? "Not provided"
                    : Model.City)
            </div>
        </div>

        <div class="col-4">
            <small class="text-muted">Disability</small>
            <div class="fw-semibold">
                @(Model.HasDisability ? "Yes" : "No")
            </div>
        </div>

        <div class="col-4">
            <small class="text-muted">Tattoo</small>
            <div class="fw-semibold">
                @(Model.HasTattoo ? "Yes" : "No")
            </div>
        </div>

    </div>

    <hr />

    <h5 class="fw-bold mb-3">
        <i class="bi bi-envelope me-2"></i>
        Contact Information
    </h5>

    <div class="mb-4">
        <small class="text-muted">Email Address</small>

        <div>
            <a href="mailto:@Model.Email"
               class="fw-semibold text-decoration-none">
                @Model.Email
            </a>
        </div>
    </div>

    <!-- DONATION STATUS -->
    @if (Model.DonationStatus == 1)
    {
        <div class="border border-success border-2 rounded-3 p-3">

            <h6 class="fw-bold text-success">
                <i class="bi bi-check-circle-fill me-2"></i>
                Potentially Eligible for Blood Donation
            </h6>

            <p class="mb-0 small">
                Based on the information provided, this donor
                has not reported donating blood within the
                previous six months.

                Their current eligibility must still be
                confirmed by a qualified healthcare professional.
            </p>

        </div>
    }
    else if (Model.DonationStatus == 2)
    {
        <div class="border border-danger border-2 rounded-3 p-3">

            <h6 class="fw-bold text-danger">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                Recently Donated Blood
            </h6>

            <p class="mb-0 small">
                Based on the information provided, this donor
                has donated blood recently.

                They may not be eligible to donate blood
                again at this time.
            </p>

        </div>
    }
    else
    {
        <div class="border border-success border-2 rounded-3 p-3">

            <h6 class="fw-bold text-success">
                <i class="bi bi-question-circle-fill me-2"></i>
                Assumed Available — Not Verified
            </h6>

            <p class="mb-0 small">
                This donor has not provided their last
                blood donation details, so they are
                currently listed as assumed available.

                Their actual eligibility is unknown.
                If you urgently need this blood group,
                please contact the donor by email to
                confirm their availability.

                A healthcare professional must confirm
                eligibility before donation.
            </p>

        </div>
    }

</div>

