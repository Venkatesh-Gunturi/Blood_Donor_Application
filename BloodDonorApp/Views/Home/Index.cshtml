@model BloodDonorApp.ViewModels.DonorSearchViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="bg-danger text-white d-flex align-items-center"
         style="min-height: 25vh;">

    <div class="container py-4">

        <div class="row align-items-center g-3">

            <!-- HERO CONTENT -->
            <div class="col-12 col-md-9">

                <h1 class="fw-bold mb-2 fs-2">
                    Every Drop Counts.
                    Every Donor Matters.
                </h1>

                <p class="mb-3 opacity-75">
                    Connecting voluntary blood donors with
                    people in need. Together, we can help
                    save lives.
                </p>

                <div class="d-flex flex-wrap gap-2">

                    <!-- FIND DONOR: SCROLL TO SECTION -->
                    <a href="#findDonors"
                       class="btn btn-light text-danger fw-semibold">
                        <i class="bi bi-search me-1"></i>
                        Find a Donor
                    </a>

                    <!-- SHOW ONLY WHEN NOT LOGGED IN -->
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-outline-light fw-semibold">
                            <i class="bi bi-heart-fill me-1"></i>
                            Become a Donor
                        </a>
                    }

                </div>

            </div>

            <!-- HERO ICON -->
            <div class="col-md-3 d-none d-md-flex justify-content-center">
                <i class="bi bi-heart-pulse-fill opacity-75"
                   style="font-size: 6rem;"></i>
            </div>

        </div>

    </div>

</section>



<!-- FIND DONORS SECTION -->
<section id="findDonors" class="container py-5">

    <div class="text-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-search text-danger me-2"></i>
            Find Blood Donors
        </h2>

        <p class="text-muted">
            Search registered blood donors by blood group
            and location.
        </p>
    </div>

    <!-- SEARCH FORM -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <form method="get"
                  asp-controller="Home"
                  asp-action="Index"
                  asp-fragment="findDonors">

                <div class="row g-3">

                    <!-- BLOOD GROUP -->
                    <div class="col-12 col-md-4">

                        <label for="bloodGroup"
                               class="form-label fw-semibold">
                            Blood Group
                            <span class="text-danger">*</span>
                        </label>

                        <select id="bloodGroup"
                                name="bloodGroup"
                                class="form-select"
                                required>

                            <option value="">
                                Select Blood Group
                            </option>

                            @foreach (var group in new[]
                            {
                                "A+", "A-",
                                "B+", "B-",
                                "AB+", "AB-",
                                "O+", "O-",
                                "Oh (Bombay)"
                            })
                                                        {
                                <option value="@group" selected="@(Model.BloodGroup == group)">
    @group
</option>
                            }

                        </select>

                    </div>

                    <!-- STATE -->
                    <div class="col-12 col-md-4">

                        <label for="state"
                               class="form-label fw-semibold">
                            State / UT
                            <span class="text-danger">*</span>
                        </label>

                        <select id="state"
                                name="state"
                                class="form-select"
                                required>

                            <option value="">
                                Select State / UT
                            </option>

                            <option value="All" selected="@(Model.State == "All")">
    All States &amp; UTs
</option>

                            @foreach (var stateName in new[]
                            {
                                "Andhra Pradesh",
                                "Arunachal Pradesh",
                                "Assam",
                                "Bihar",
                                "Chhattisgarh",
                                "Goa",
                                "Gujarat",
                                "Haryana",
                                "Himachal Pradesh",
                                "Jharkhand",
                                "Karnataka",
                                "Kerala",
                                "Madhya Pradesh",
                                "Maharashtra",
                                "Manipur",
                                "Meghalaya",
                                "Mizoram",
                                "Nagaland",
                                "Odisha",
                                "Punjab",
                                "Rajasthan",
                                "Sikkim",
                                "Tamil Nadu",
                                "Telangana",
                                "Tripura",
                                "Uttar Pradesh",
                                "Uttarakhand",
                                "West Bengal",
                                "Andaman and Nicobar Islands",
                                "Chandigarh",
                                "Dadra and Nagar Haveli and Daman and Diu",
                                "Delhi",
                                "Jammu and Kashmir",
                                "Ladakh",
                                "Lakshadweep",
                                "Puducherry"
                            })
                            {
                                <option value="@stateName" selected="@(Model.State == stateName)">
    @stateName
</option>
                            }

                        </select>

                    </div>

                    <!-- PIN CODE -->
                    <div class="col-12 col-md-4">

                        <label for="pinCode"
                               class="form-label fw-semibold">
                            PIN Code
                            <span class="text-muted small">
                                (Optional)
                            </span>
                        </label>

                        <input type="text"
                               id="pinCode"
                               name="pinCode"
                               class="form-control"
                               placeholder="Enter 6-digit PIN"
                               maxlength="6"
                               minlength="6"
                               pattern="[0-9]{6}"
                               inputmode="numeric"
                               title="Enter a valid 6-digit PIN code"
                               value="@Model.PinCode"/>

                    </div>

                </div>

                <!-- BUTTONS -->
                <div class="d-flex justify-content-center
                            gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-search me-1"></i>
                        Search Donors

                    </button>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="findDonors"
                       class="btn btn-outline-secondary px-4">

                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Reset

                    </a>

                </div>

            </form>

        </div>

    </div>

    
<!-- SEARCH RESULTS -->
<div id="searchResults" class="mt-5">

    @if (!Model.HasSearched)
    {
        <!-- INITIAL STATE -->
        <div class="text-center py-4">

            <i class="bi bi-people text-secondary"
               style="font-size: 3rem;"></i>

            <h5 class="fw-semibold mt-3">
                Find Someone Who Can Help
            </h5>

            <p class="text-muted">
                Select a blood group and location,
                then search to view registered donor records.
            </p>

        </div>
    }
    else if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <!-- VALIDATION ERROR -->
        <div class="alert alert-warning rounded-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @Model.ErrorMessage
        </div>
    }
    else if (Model.Donors.Count == 0)
    {
        <!-- NO MATCHING DONORS -->
        <div class="text-center py-4">

            <i class="bi bi-person-x text-secondary"
               style="font-size: 3rem;"></i>

            <h5 class="fw-semibold mt-3">
                No Registered Donor Records Found
            </h5>

            <p class="text-muted">
                @Model.EmptyMessage
            </p>

            <p class="small text-muted">
                Try searching another location or
                removing the PIN code filter.
            </p>

        </div>
    }
    else
    {
        <!-- RESULTS HEADER -->
        <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-2 mb-4">

            <div>
                <h4 class="fw-bold mb-1">
                    Based on Your Search
                </h4>

                <p class="text-muted small mb-0">
                    @Model.Donors.Count registered donor record(s)
                    found in BloodDonorApp.
                </p>
            </div>

            <!-- FILTER BUTTON - COMING NEXT -->
            <button class="btn btn-outline-danger"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#advancedFilters"
        aria-expanded="false"
        aria-controls="advancedFilters">
    <i class="bi bi-funnel"></i> Filters
</button>

        </div>

        
<div class="collapse mt-3 @(Model.MinAge != 18 ||
                             Model.MaxAge != 65 ||
                             !string.IsNullOrWhiteSpace(Model.GenderFilter) ||
                             Model.HasTattooFilter.HasValue ? "show" : "")"
     id="advancedFilters">
    <div class="card card-body border-danger-subtle">

        <h5 class="mb-3">Filter Donors</h5>

        <form method="get"
              asp-controller="Home"
              asp-action="Index"
              asp-fragment="searchResults">

            <!-- Preserve original search values -->
            <input type="hidden" name="bloodGroup"
                   value="@Model.BloodGroup" />

            <input type="hidden" name="state"
                   value="@Model.State" />

            <input type="hidden" name="pinCode"
                   value="@Model.PinCode" />

            <div class="row g-3">

                <!-- Minimum age -->
                <div class="col-md-3">
                    <label for="minAge" class="form-label">
                        Minimum Age
                    </label>

                    <input type="number"
                           class="form-control"
                           id="minAge"
                           name="minAge"
                           min="18"
                           max="65"
                           value="@Model.MinAge"
                           required />
                </div>

                <!-- Maximum age -->
                <div class="col-md-3">
                    <label for="maxAge" class="form-label">
                        Maximum Age
                    </label>

                    <input type="number"
                           class="form-control"
                           id="maxAge"
                           name="maxAge"
                           min="18"
                           max="65"
                           value="@Model.MaxAge"
                           required />
                </div>

                <!-- Gender -->
                <div class="col-md-3">
                    <label for="genderFilter" class="form-label">
                        Gender
                    </label>

                    <select class="form-select"
                            id="genderFilter"
                            name="genderFilter">

                        <option value="">All Genders</option>

                        <option value="Male"
                                selected="@(Model.GenderFilter == "Male")">
                            Male
                        </option>

                        <option value="Female"
                                selected="@(Model.GenderFilter == "Female")">
                            Female
                        </option>

                        <option value="Other"
                                selected="@(Model.GenderFilter == "Other")">
                            Other
                        </option>
                    </select>
                </div>

                <!-- Tattoo -->
                <div class="col-md-3">
                    <label for="hasTattooFilter" class="form-label">
                        Tattoo
                    </label>

                    <select class="form-select"
                            id="hasTattooFilter"
                            name="hasTattooFilter">

                        <option value="">All</option>

                        <option value="true"
                                selected="@(Model.HasTattooFilter == true)">
                            Yes
                        </option>

                        <option value="false"
                                selected="@(Model.HasTattooFilter == false)">
                            No
                        </option>
                    </select>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-danger">
                    Apply Filters
                </button>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-route-bloodGroup="@Model.BloodGroup"
                   asp-route-state="@Model.State"
                   asp-route-pinCode="@Model.PinCode"
                   asp-fragment="searchResults"
                   class="btn btn-outline-secondary">
                    Clear Filters
                </a>
            </div>

        </form>
    </div>
</div>

<div class="modal fade"
     id="donorDetailsModal"
     tabindex="-1"
     aria-labelledby="donorDetailsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">

        <div class="modal-content" id="donorModalContent">
            <div class="modal-body text-center py-5">
                Loading donor details...
            </div>
        </div>

    </div>
</div>


        <!-- AVAILABLE DONORS -->
        @if (Model.AvailableCount > 0)
        {
            <h5 class="fw-semibold mb-3">
                <i class="bi bi-check-circle text-success me-2"></i>
                Potentially Eligible Donors
                <span class="text-muted">
                    (@Model.AvailableCount)
                </span>
            </h5>

            <div class="row g-3 mb-5">

                @foreach (var donor in Model.Donors.Where(d => d.IsAvailable))
                {
                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="card h-100 shadow-sm border-0 rounded-4"><div class="card h-100 shadow-sm donor-card"
     role="button"
     tabindex="0"
     data-donor-id="@donor.Id"
     aria-label="View details of @donor.FirstName @donor.LastName">
                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between
                                            align-items-start gap-2 mb-3">

                                    <h5 class="fw-bold mb-0">
                                        @donor.FirstName @donor.LastName
                                    </h5>

                                    <span class="badge bg-success">
                                        Potentially Eligible
                                    </span>

                                </div>

                                <p class="mb-2">
                                    <strong>Age:</strong> @donor.Age
                                </p>

                                <p class="mb-2">
                                    <strong>Gender:</strong> @donor.Gender
                                </p>

                                <p class="mb-2">
                                    <strong>Blood Group:</strong>
                                    <span class="badge bg-danger">
                                        @donor.BloodGroup
                                    </span>
                                </p>

                                <p class="mb-0">
                                    <strong>State:</strong> @donor.State
                                </p>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

        <!-- UNAVAILABLE DONORS -->
        @if (Model.UnavailableCount > 0)
        {
            <h5 class="fw-semibold mb-3">
                <i class="bi bi-clock-history text-secondary me-2"></i>
                Currently Ineligible Donors
                <span class="text-muted">
                    (@Model.UnavailableCount)
                </span>
            </h5>

            <div class="row g-3">

                @foreach (var donor in Model.Donors.Where(d => !d.IsAvailable))
                {
                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="card h-100 shadow-sm border-0 rounded-4">

                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between
                                            align-items-start gap-2 mb-3">

                                    <h5 class="fw-bold mb-0">
                                        @donor.FirstName @donor.LastName
                                    </h5>

                                    <span class="badge bg-secondary">
                                        Currently Ineligible
                                    </span>

                                </div>

                                <p class="mb-2">
                                    <strong>Age:</strong> @donor.Age
                                </p>

                                <p class="mb-2">
                                    <strong>Gender:</strong> @donor.Gender
                                </p>

                                <p class="mb-2">
                                    <strong>Blood Group:</strong>
                                    <span class="badge bg-danger">
                                        @donor.BloodGroup
                                    </span>
                                </p>

                                <p class="mb-0">
                                    <strong>State:</strong> @donor.State
                                </p>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }

</div>


        <div class="text-center py-4">

            <i class="bi bi-people text-secondary"
               style="font-size: 3rem;"></i>

            <h5 class="fw-semibold mt-3">
                Find Someone Who Can Help
            </h5>

            <p class="text-muted">
                Select a blood group and location,
                then click Search Donors to see
                registered donor records.
            </p>

        </div>

    </div>

</section>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const modalElement =
                document.getElementById("donorDetailsModal");

            const modalContent =
                document.getElementById("donorModalContent");

            const donorModal =
                bootstrap.Modal.getOrCreateInstance(modalElement);

            const detailsUrl =
                '@Url.Action("DonorDetails", "Home")';

            async function openDonorDetails(donorId) {

                modalContent.innerHTML = `
                    <div class="modal-body text-center py-5">
                        <div class="spinner-border text-danger"
                             role="status">
                            <span class="visually-hidden">
                                Loading...
                            </span>
                        </div>
                        <p class="mt-3 mb-0">
                            Loading donor details...
                        </p>
                    </div>
                `;

                donorModal.show();

                try {
                    const response = await fetch(
                        `${detailsUrl}?id=${encodeURIComponent(donorId)}`
                    );

                    if (!response.ok) {
                        throw new Error("Unable to load donor details.");
                    }

                    const html = await response.text();

                    modalContent.innerHTML = html;
                }
                catch (error) {
                    modalContent.innerHTML = `
                        <div class="modal-header">
                            <h5 class="modal-title">
                                Unable to Load Details
                            </h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-warning mb-0">
                                Donor details could not be loaded.
                                Please try again.
                            </div>
                        </div>
                    `;
                }
            }

            document.querySelectorAll(".donor-card")
                .forEach(card => {

                    card.addEventListener("click", function () {
                        openDonorDetails(this.dataset.donorId);
                    });

                    card.addEventListener("keydown", function (event) {
                        if (event.key === "Enter" ||
                            event.key === " ") {
                            event.preventDefault();
                            openDonorDetails(this.dataset.donorId);
                        }
                    });

                });

        });
    </script>
}
